{
    "name": "太上黄庭中景經",
    "author": "唐・李千乘",
    "loadChapterCount": 1,
    "chapters": [
        {
            "name": "太上黄庭中景經",
            "paragraphs": [
                {
                    "paragraph": "太上黄庭中景經",
                    "zhushu": "",
                    "type": 1
                },
                {
                    "paragraph": "上清元命眞人李千乘注",
                    "zhushu": "",
                    "type": 2
                },
                {
                    "paragraph": "黄老黄庭經",
                    "zhushu": "洞房經云：人有大室，正房黄庭，庭中黄老君所居，元始也。龜山籙經云：黄老君在上清金珠府理化。黄者，是中正色也。庭者，四方之中也。外取在天中地中、雲霞之上，内取於腦中、心、肝、脾之間。爲道者，莫不煉存形神，尅成羽化，以致長生，超出圓羅之表，故曰黄庭者也。",
                    "type": 2
                },
                {
                    "paragraph": "念吾頭頂戴天神。",
                    "zhushu": "三元之氣，降生三八景神，生於人身上洞天部。一景生腦神之府，有元氣。人腦有九瓣，内生九眞，皆列次位，以繞丹田，而外其面，以禦不祥。上眞上向，高眞南向，太眞東向，神眞西向，玄眞北向。二十四神行事訣云：腦神在頸九宫正九，當頂内腦膏之中，形長一寸一分，高五分半，向前面外坐，守丹田神是也。",
                    "type": 2
                },
                {
                    "paragraph": "髮爲星辰萬餘綸。",
                    "zhushu": "髮神名玄父華，字道衛，形長二寸一分，色正玄，在軀皮内膏外，周流髮根，正在頭上。萬物之中，人之最貴，一形之内，包含天地，日月星辰，社稷剛柔，無所不法；亦立天子，置三公、九卿、二十七大夫、八十一元士，百二十郡、千二百縣、萬八千鄉、三萬六十亭長，十八侯；亦有宫闕、宅舍、門户、竈井諸神。飲食而知修者，即得長生。所以頭圓象天，足方象地，髮爲星辰，目爲日月，眉爲北斗，耳爲社禝口，爲江海，齒爲玉石。綸，理也。髮之始必一，又存神也。",
                    "type": 2
                },
                {
                    "paragraph": "紆長槃屈光若玄，",
                    "zhushu": "紆迴屈曲槃結，櫛髮不必解髻。面有神庭。髻，腦之華。心悲髮焦。髓滿骨堅，不洩精氣。頂上中央名通天，入髮際一寸，頂名通天，棲神之宅也。"
                },
                {
                    "paragraph": "孔德之容大如錢，",
                    "zhushu": "道德經云：孔德之容，唯道是從。爲衆妙之門者也。"
                },
                {
                    "paragraph": "天星和氣從此間。",
                    "zhushu": "頭爲三台，天星九眞君其上矣。",
                    "type": 2
                },
                {
                    "paragraph": "養人骨髓浸靈根，",
                    "zhushu": "絳宫三景合明養人眞。靈根，舌也。本，靈根者是也。"
                },
                {
                    "paragraph": "下和六府紹五官，",
                    "zhushu": "腸、胃、大小腸、膀胱、三焦爲六府，心、肝、肺、脾、腎爲五宫。"
                },
                {
                    "paragraph": "消除惡氣出臍門，",
                    "zhushu": "下丹田入命根，精神之本，截五氣、分陰陽之户也。朝餐玉饌，暮爲穢滓之氣是也。"
                },
                {
                    "paragraph": "還念兩目白黑分，",
                    "zhushu": "目者，是身之明鏡也。林夫人咒曰：目童三雲，兩目眞君。丹字紫書云：常存目中三神，合眞内現，即見五藏腸胃，久行神仙矣。"
                },
                {
                    "paragraph": "左目爲日天神存，",
                    "zhushu": "左目象日，神名上明，字英玄，一名飛靈也。"
                },
                {
                    "paragraph": "象長一寸衣丹玄，",
                    "zhushu": "目中童子人長一寸，服玄衣。"
                },
                {
                    "paragraph": "十二神女廻四邊；",
                    "zhushu": "左目外有十二眞人，周迴營衛目也。"
                },
                {
                    "paragraph": "右目爲月太一然，",
                    "zhushu": "右目象月，神名太一，字晨嬰，一名明珠。鷄鳴時存東方青氣從月來，滿泥丸，泥丸中有青煙，又從目出欎欎然，變成二童子，著青衣，如嬰兒形狀者矣。"
                },
                {
                    "paragraph": "神長一寸衣白，紈",
                    "zhushu": "左目眞人長一寸。白紈，素衣也。"
                },
                {
                    "paragraph": "十二神女周成還。",
                    "zhushu": "左目十二神女，十二眞人周還坐衛目也。"
                },
                {
                    "paragraph": "日月相去三寸，間",
                    "zhushu": "日月，兩目。相去三寸。"
                },
                {
                    "paragraph": "中有北斗七政陳，",
                    "zhushu": "存北斗七星天中帝卿，帝卿玄宫。玄宫從准頭直上，至髮際五寸。於夜半東向平坐散髮，呼上元三眞，眞中嬰兒大人面，各有門户，七政如北極紫房也。面上眞人神皆有方位，若視北極紫房玉闕是也。"
                },
                {
                    "paragraph": "上有元一五華君，",
                    "zhushu": "元一五華，五藏神也。"
                },
                {
                    "paragraph": "當頭如居圎如槃，",
                    "zhushu": "太一在頭，頭法天。圓槃，堅固者也。"
                },
                {
                    "paragraph": "象長七寸變化神。",
                    "zhushu": "形長七寸。"
                },
                {
                    "paragraph": "耳象晝夜空如聦，",
                    "zhushu": "修道先令目明耳聰爲事主也。耳目是尋真之梯級，綜靈之門户。夫目欲得數按抑其左右，亦令無數，使人聰徹，所以營理城郭，名書玉皇也。"
                },
                {
                    "paragraph": "中有黄庭主聽門，",
                    "zhushu": "黄庭是腦中眞人也。"
                },
                {
                    "paragraph": "欲下天神如赤丹，",
                    "zhushu": "九眞降下於腦宫。丹者，仙服也。"
                },
                {
                    "paragraph": "蓋長三寸青幘冠。",
                    "zhushu": "耳神名嬌女，一名空閑，字幽田，形長三寸，青幘冠也。"
                },
                {
                    "paragraph": "常居鼻上候百神，",
                    "zhushu": "大洞級云：鼻神名山源，一名鬼井。有三元之山嶽，能候萬神，爲邪正之主也。"
                },
                {
                    "paragraph": "念鼻通利芳如香，",
                    "zhushu": "引靈注體，調和百神也。"
                },
                {
                    "paragraph": "中有一人衣黄金，",
                    "zhushu": "鼻中眞人黄金仙服。"
                },
                {
                    "paragraph": "神長二寸出居人。",
                    "zhushu": "鼻神長二寸二分半，向外坐，主神他居，在人中上。"
                },
                {
                    "paragraph": "清虚神氣處中央，",
                    "zhushu": "鼻中嶽，處中央，内通腦雙孔。丹田清眞之氣，爲邪正之氣都府，是一身之武津道者。先塞山源鬼井，悔吝不動，長生無咎也。"
                },
                {
                    "paragraph": "令我不惑知四方。",
                    "zhushu": "齋戒常革夷心注，立是不惑，耳、鼻、舌各居一處，爲四方者。"
                },
                {
                    "paragraph": "念口鴻赤大如方，",
                    "zhushu": "含氣養精，易曰：觀我朵頥，自求口實。"
                },
                {
                    "paragraph": "多淤玉液涌金糧，",
                    "zhushu": "口中津爲玉液，不食五糓，吸風飲露。金糧，不飲之貌是也。"
                },
                {
                    "paragraph": "神長七寸赤如强，",
                    "zhushu": "口中眞人名赤虚丈人，字素明，在玄扉之下，形長七寸一分，高三寸半，向外，服赤衣。强者，猶堅盛之貌也。"
                },
                {
                    "paragraph": "左右展轉吸玉漿。",
                    "zhushu": "展轉，反覆。中有眞人，能吸津液，徃來不倦。"
                },
                {
                    "paragraph": "象斗鉞初受四方，",
                    "zhushu": "眞人器鉞，遏邪之狀。初，調神之物。學道之士，先當拘魂魄，消滅尸鬼。常以月晦日、庚申、甲寅之辰，清齋入室，以眞朱筆點左目眥下，雄黄筆點右鼻下，令一小入谷中訖，微咒，叩齒三通，咽液三過，以左手第二指捻右鼻孔下，右手第二指捻左目下，各七遍當搜之勿舉手也。於是都畢。此二處是三魂七魄之門户，鉞減精邪之津梁也。故朱黄之精，塞尸鬼之路，乃太極上法，行之則魂魄和氣，尸穢散絶，靈通徹視，行之三年，色念都泯，四支無疾，以長生者也。"
                },
                {
                    "paragraph": "神長三寸衣玄黄。",
                    "zhushu": "神在腦中第一節，居於骨，形長三寸，高一寸七分半，向外坐也。"
                },
                {
                    "paragraph": "固其神女東西厢，",
                    "zhushu": "體中皆有男女眞君，列陰陽之位。厢左右洞房明堂官，眞人在其中央，位相望也。"
                },
                {
                    "paragraph": "扶持黄泉五味長。",
                    "zhushu": "黄泉是頷下喉上。五味入。口，咀嚼而咽，皆眞人扶持。"
                },
                {
                    "paragraph": "此道妙神利鋒芒，",
                    "zhushu": "自然妙有神通。鋒芒，利器。夫人道所生，神所育，含靈受爽，以成乎身。百姓日用不知，萬物得之而不見，潜行内運，或曜無方矣。"
                },
                {
                    "paragraph": "神長七寸衣赤丹，",
                    "zhushu": "神長七寸，在玉枕中腦内户髓膏内，向前坐，丹赤衣。"
                },
                {
                    "paragraph": "群神化養滋五常。",
                    "zhushu": "眞人爲群神五常陰陽之主，衆聚曰群。滋，生也。眞人化養生人身也。"
                },
                {
                    "paragraph": "大管蕃茂令上方，",
                    "zhushu": "大管，玄膺。在舌下喉上，一名下管，受上下膺。其管受精蕃茂，形長八寸，故曰蕃也。"
                },
                {
                    "paragraph": "能知舌道壽未央。",
                    "zhushu": "舌者，無英之龍機，若能修之，致長生。"
                },
                {
                    "paragraph": "舌根玉𦞣赤如丹，",
                    "zhushu": "玉𦞣，舌名也。若用機行能，以消剛柔者也。"
                },
                {
                    "paragraph": "主禀滋味通醴泉。",
                    "zhushu": "舌是心之官，舌和則審五味。醴泉，津唾者也。"
                },
                {
                    "paragraph": "下念喉嚨十二環，",
                    "zhushu": "喉神名虎賁，眞氣之路，津液之源，一名重堂，在頷下，故曰下念。絳宫重樓十二級，外應十二時亭長也。"
                },
                {
                    "paragraph": "自下通流兩乳間。",
                    "zhushu": "喉嚨向下也。兩乳名天府，玉堂眞人居其。間"
                },
                {
                    "paragraph": "中有陰陽夫妻仙，",
                    "zhushu": "左乳屬陽，男眞所居，右乳屬陰，女眞所居，形長八寸，高四寸，各面就坐相對向。似人相對，曰夫妻也。"
                },
                {
                    "paragraph": "對持玉㦸四方邊，",
                    "zhushu": "持，猶執也。玉戟，猶眞人之以守喉嚨。四方謂𦙄膈上下，乳内外也。"
                },
                {
                    "paragraph": "飲食不累詎令還。",
                    "zhushu": "上焦旣通，水穀不積，能歸下元也。"
                },
                {
                    "paragraph": "念肺五葉象玉光，",
                    "zhushu": "五藏次第，肺最爲上，對𦙄，有五葉，如紗映縠者也。"
                },
                {
                    "paragraph": "青白皓皓若氷霜，",
                    "zhushu": "氷霜皓皓，肺主西方，金之正位也。"
                },
                {
                    "paragraph": "鄒震覆心衛四方，",
                    "zhushu": "肺在心上，故曰覆。鄒，仙兵也。衛，近也。肺業四垂以近心，故曰四方也。"
                },
                {
                    "paragraph": "上有玄童象月光，",
                    "zhushu": "肺神名皓華，字虚成，在肺中，神長四寸半，白衣，向斗坐。月，陰精。肺主陰，如月光也。"
                },
                {
                    "paragraph": "眞精華蓋内修明，",
                    "zhushu": "肺，心之華蓋。在肝上，故曰明也。"
                },
                {
                    "paragraph": "肺中空洞上下行，",
                    "zhushu": "肺藏魂魄之官，魂性虚浮，鼻通天氣，垂掩葉以掩内孔，相應爲上下行也。"
                },
                {
                    "paragraph": "大如銳孔通太常，",
                    "zhushu": "保氣則得通神保精也。保精則神明。肺體輕浮，隱孔内屬，精氣徃來，自然昇降也。"
                },
                {
                    "paragraph": "乏絶道使享之亡，",
                    "zhushu": "六府調和，神明則住，三部不寧，我眞必散。享，去聲也。"
                },
                {
                    "paragraph": "絶立無萬神不詳，",
                    "zhushu": "道去身人死，水乾魚終。萬神皆散，豈不亡也。"
                },
                {
                    "paragraph": "養性審之喘息端，",
                    "zhushu": "修身養性，閉氣一名煉氣，一名胎息，從夜半至日中爲生氣，從日中至夜半爲死氣。常以生氣時偃仰，冥目握固，閉氣無息於中心，至百二十，口中出之，日增其數。如此身神見，五藏安。至二百五十日，即絳宫神守，泥丸常滿，丹田盛數。至三百日，華蓋自明耳，舉身無病。引息之法，寒熱不畜，水糓無滯，一日一夜萬三千五百息。經千焉，具能養一身。具元氣，則無門不通，無脉不齊，無畜不散。仰頭縮鼻，而氣上昇。龜導縮頭含息，精氣下行；蛇導正屈不直，而氣上昇即周旋；人導閉口微息，氣入丹田，能明嘘吸，神眞内備，飛上紫清，由喘息之所致也。"
                },
                {
                    "paragraph": "上有流神五形彰，",
                    "zhushu": "流神，五藏神明。彰，明審而思之，其形乃明矣。"
                },
                {
                    "paragraph": "風伯雨師調陰陽，",
                    "zhushu": "風伯名比君，號曰長齋；雨師名馮修，號拊徒。在人腦户曰廟，在人項後名仕，在脾端名禝，在人大腸曰風伯，在臍傍名雨師。易曰：一陰一陽之謂道。近取諸身，遠取諸物。南華經曰：天在人中，地在人中。包含萬物，自然玄運在身也。"
                },
                {
                    "paragraph": "伏羲女媧或存亡，",
                    "zhushu": "伏羲，三皇之王。女媧，上古之君。皆創立革扶，制造權輿。人三宫五藏之内，有此君王。胃太倉，乃三皇五帝府傳之也。"
                },
                {
                    "paragraph": "肺合太白華陰鄉，",
                    "zhushu": "肺，雍州之分，主西嶽華山也。"
                },
                {
                    "paragraph": "出駕白虎乘風雨。",
                    "zhushu": "肺神在外爲白虎。大洞經云：肺君白元君也。居洞房宫，出駕白虎，或乘白氣。從官太和君，二千六百騎矣。"
                },
                {
                    "paragraph": "心紫五寸銳下行，",
                    "zhushu": "心爲帝君，居肺下肝上，對尻尾下一寸。心者，一名絳宫，爲一身之主，以管萬民，呼吸諸神，無不到者。銳者，心中孔，應八門萬神出入也。"
                },
                {
                    "paragraph": "營若靈根扶中央，",
                    "zhushu": "靈根，命根也，玉液化清水灌之。子能修三寸，長存心居中央也。"
                },
                {
                    "paragraph": "明珠赤白如日光，",
                    "zhushu": "明珠即心中精。面色如縞映絳也。"
                },
                {
                    "paragraph": "中有三孔氣堂堂，",
                    "zhushu": "心有三孔，精氣流行。堂堂，施張貌也。"
                },
                {
                    "paragraph": "千乘一朝導明堂，",
                    "zhushu": "夫修道者，皆灰心槁體，坐忘遺彼，聰内自爽，形神羅照，一身之内，見千乘萬騎。眉間却入一寸爲明堂也。"
                },
                {
                    "paragraph": "精營霍山在南方，",
                    "zhushu": "心楊州之分，衡嶽霍山。"
                },
                {
                    "paragraph": "心君要妙衣太陽",
                    "zhushu": "心神童子一名要。要妙，太陽之正色是也。"
                },
                {
                    "paragraph": "縝緑曜赫履朱冠，",
                    "zhushu": "縝緑，仙髮，或心中暉赤之色也。戴華蓋，朱雀是也。"
                },
                {
                    "paragraph": "九度明帶服赤兵，",
                    "zhushu": "三部内各爲九度，上元九氣爲冠蓋使者，中元九氣爲諫議，下元九氣爲鴻臚，三九二十七大神，皆部制神靈，主運驅體。然義有兩說。九度，九竅也。明帶，赤脉交加，連兵捍武。上部九變，中部九孔，下部九名，以通九州也。"
                },
                {
                    "paragraph": "飲食華澧太陽東",
                    "zhushu": "飲食水穀華澧津液，旣從上流下，須攝運，運心次肝。左主東方，故曰太陽之東也。"
                },
                {
                    "paragraph": "當如赤子精神澄，",
                    "zhushu": "赤子，嬰兒，心神。長九寸，高四寸半，赤衣，面向外坐也。"
                },
                {
                    "paragraph": "出駕丹車御三雙，",
                    "zhushu": "丹車，心正色，居絳宫元陽府，出或赤氣三亭，人心面主南方陽心之位，與面相應，出則從官南老人，三千六百騎衛也。"
                },
                {
                    "paragraph": "隆蓋朱輿赤帷裳，",
                    "zhushu": "隆，高。赤，烏。蓋丹蛇爲轝也。"
                },
                {
                    "paragraph": "丹烏持符鼓翼翔，",
                    "zhushu": "丹烏，朱雀，乃敗外象，故玄武水玉液，朱雀見，終日用之，故不遍。符，氣也。人氣從下向上出，仰如飛烏舉翼也。"
                },
                {
                    "paragraph": "出入上下論九星，",
                    "zhushu": "九氣化爲九神，在人身中。大洞經云：天皇九魂，變化爲之也。"
                },
                {
                    "paragraph": "計曾清神絶存亡，",
                    "zhushu": "計，念。曾，易。清神，五藏神。人能胎息養氣，必易生死，則神仙可得也。"
                },
                {
                    "paragraph": "遷徙得天制其裳，",
                    "zhushu": "心爲身主，制動爲神，微妙飛形，深誠正靜，則五映也。"
                },
                {
                    "paragraph": "下歷長城度九梁。",
                    "zhushu": "崑崙山有五城十二樓，人内亦有之，在下部。九梁，下元九氣是也。"
                },
                {
                    "paragraph": "肝青七葉寄膽倉，",
                    "zhushu": "肝東方木青，左三右四葉，色如縞。連膽，故言寄也。"
                },
                {
                    "paragraph": "狀如鳧翁鳥翼翔，",
                    "zhushu": "取鳧外喻，鳧，水鳥。若胎息旣眞，神虚必備，肝滿則超，如鳧欲翔。"
                },
                {
                    "paragraph": "復似鵲䓗走日中，",
                    "zhushu": "似九鶴鴝鵒也。氣滿肝盛，如雉高飛，若昇天入日中也。"
                },
                {
                    "paragraph": "中多諸神東西王，",
                    "zhushu": "神者，天映君，一名公子，一名含明，肝元眞神。靈寶經云：无英公子，白元尊神，下鎮人身，在泥丸宫是也。"
                },
                {
                    "paragraph": "宫屬皇疊紫亭郷，",
                    "zhushu": "肝有青陽宫，中有無英眞人，其神王生録。叠，精也。紫亭鄉，目也。目氣紫，主肝也。人飲濁肝盛，則目暗；至人道虚肝滿，則目明。若吐納旣備，肝膽内充，則精神和，精以成一德，無傾覆殆也。"
                },
                {
                    "paragraph": "肝之妙神衣青光，",
                    "zhushu": "肝色青，東方木星，正色也。"
                },
                {
                    "paragraph": "形長八寸乘青龍，",
                    "zhushu": "長八寸，青色之衣，居明堂宫，出乘青龍，青色之車，從官東極老人三千六百騎也。"
                },
                {
                    "paragraph": "上包歲星岱嶽宗。",
                    "zhushu": "歲星，角亢。岱宗東嶽，青州。"
                },
                {
                    "paragraph": "膽在肝中色緑漿，",
                    "zhushu": "膽在肝中左右葉之間，水延下碧緑色，盛水青黄白，緑漿是也。"
                },
                {
                    "paragraph": "大如鷄子中正黄，",
                    "zhushu": "二十四神行事訣云：膽色青黄緑，大如鷄子是也。"
                },
                {
                    "paragraph": "神長三寸衣青陽，",
                    "zhushu": "膽名龍躍，形長三寸八分，青黄色，向外坐也。"
                },
                {
                    "paragraph": "精爲螣虵辟蜚祥，",
                    "zhushu": "膽爲六府，外爲螣虵，亦爲青龍。膽剛勇奮發，能隂不祥。蜚，毒蟲，或云三尸蟲是也。"
                },
                {
                    "paragraph": "名曰軌敵御四方。",
                    "zhushu": "六府之神，膽晨壯勇，人行邪正，皆在膽。膽正則無事自安，膽邪竅之見滅。常能外禦，軌則法膽，主捍敵。夫修上道，莫不由於膽也。"
                },
                {
                    "paragraph": "胃受三升應日月，",
                    "zhushu": "胃太倉，隨五藏、逐四季而行。胃水穀之海，大腸之委輸，神靈所含。"
                },
                {
                    "paragraph": "上白中澤赤文章，",
                    "zhushu": "胃色外白，中則𣋆赤有文章也。"
                },
                {
                    "paragraph": "中有和氣上微王，",
                    "zhushu": "和氣，眞氣也。微王，胃中眞人。胃開五藏明，胃閉五藏暗，爲萬靈之溢塞，成一軀之要津，雲行雨施，皆由其始也。"
                },
                {
                    "paragraph": "渴思其水當玉漿，",
                    "zhushu": "大洞經云：夫服玄根之法，心存胃口，有女子如嬰兒，無衣，正立胃管，張口承注魂液，仰吸五氣，口中津液滿口咽之，遣入玄女口中。五過畢，叩齒三通，咽液九過，皆依是法也。"
                },
                {
                    "paragraph": "飢思其内象黄糧，",
                    "zhushu": "飢則咽液，是自然之糧。黄，中央正也。"
                },
                {
                    "paragraph": "神長三寸衣中央，",
                    "zhushu": "神名黄帝子，形長三寸，衣黄衣，向外坐，消磨食物也。"
                },
                {
                    "paragraph": "變化丹田百病亡。",
                    "zhushu": "赤子居上丹田，眞人居中丹田，嬰兒居下丹田。一神名眞人，字子丹，一名光堅。人能存之，即無病夭。眞人貴三田合而成一，神仙之本也。"
                },
                {
                    "paragraph": "脾之嬖媵色正黄，",
                    "zhushu": "脾，黄庭之宫也。脾横胃上，色黄明也。"
                },
                {
                    "paragraph": "兩木頗銳迫太倉，",
                    "zhushu": "兩木，兩邊銳堅，迫著胃，爲太倉兩邊也。"
                },
                {
                    "paragraph": "狀象金墜色混，熿",
                    "zhushu": "金，堅剛。脾有故，膏膜如縞裹黄白，混横是也。"
                },
                {
                    "paragraph": "常甘包裹開庭堂，",
                    "zhushu": "凡爲道者，令三關常調，是根精固髓。三關調，五藏安，則身無病也。"
                },
                {
                    "paragraph": "神長九寸衣黄光，",
                    "zhushu": "脾長九寸，黄衣，八景神童名字，人欲存時，則形長三寸，横於胃，朝爲老君，暮爲明堂太一君是也。"
                },
                {
                    "paragraph": "出乘蒼車駕龍翔，",
                    "zhushu": "脾爲明堂宫、太崇府，中有玄光玉女。丹田之女，出乘黄龍之車，從官黄老君三千六百騎也。"
                },
                {
                    "paragraph": "上連鎮星少室堂，",
                    "zhushu": "鎮星，玄房。少室者，中嶽豫州也。"
                },
                {
                    "paragraph": "主生五味養四行，",
                    "zhushu": "脾分五味，制强四方，是爲主。"
                },
                {
                    "paragraph": "可以不飢禀神明。",
                    "zhushu": "精液内備，神具體安，不飢不渴，長生久視，定慧自然也。"
                },
                {
                    "paragraph": "腎黑俠脊當臍居，",
                    "zhushu": "腎居下部水宫，在臍下三寸，附著脊，左爲命府，右爲太和，左司徒，右司寇。腎在臍内兩邊，主運三焦之氣，灌溉津液通之路。元陽子云：寒暑相生，男女相形，腎中二神青衣，左男戴日，右女戴月，至夜半時，人能精存思，則可得見也。"
                },
                {
                    "paragraph": "大如一拳如覆柸，",
                    "zhushu": "下丹田人命根神宅，藏五氣，左青右黄，上黑下白，如大拳是也。"
                },
                {
                    "paragraph": "又似大鼠如關臺，",
                    "zhushu": "腎如伏牛，大小如鼠。臺，向腎形，腎部之宫玄關臺也。"
                },
                {
                    "paragraph": "快如純漆鳥憧來，",
                    "zhushu": "腎色如黑漆，旣若秠鼠，又復如鳥，若胎息旣滿，引腎氣雙孚，上如飛鳥而欲飄舉，憧憧然是也。"
                },
                {
                    "paragraph": "黄白足脂若軀中，",
                    "zhushu": "眞精溢滿，如人體光悅也。"
                },
                {
                    "paragraph": "中多無形萬物神，",
                    "zhushu": "無形生於有形，隱伏能生赤子也。"
                },
                {
                    "paragraph": "大寶之宫中天部，",
                    "zhushu": "夫無用即有所寶，無用而常足者，莫妙乎道，故三度之中，各有九人，右有司命，左有司録，左司廷尉，皆内外速記人善惡。腎爲玄元君、元陽子。命門一名玉都，下丹田也。精氣出入，神居之所，當臍後是也。故尋眞之士，外身幽巖，屏絶人事，恐犯女穢，則下丹田危人鬰録，冥司奪算。三一經云：以夜半時，甲子、戊子、壬子日呼之曰，北極名玄通女，某乙欲得金液、玉漿、醴泉可飲者。因冥思念腎間有白氣，左有司命，右有司録，呼之曰，司録六丁玉女，削去某乙死籍。皆當言之生我，能知三一神名，可長生矣。易曰：聖人之大寶曰位。言萬象在人身内也。"
                },
                {
                    "paragraph": "神長六寸衣赤褐，",
                    "zhushu": "神名玄冥，字育嬰，長六寸七分半，衣白，外向坐是也。"
                },
                {
                    "paragraph": "出駕玄武御神龜，",
                    "zhushu": "玄武神龜，北方正色。腎爲幽暗府，中有太一君，出駕玄武與飛龜，從君官北極老人三千六百騎是也。"
                },
                {
                    "paragraph": "戴水上下浸九州，",
                    "zhushu": "腎兩邊名溪水，中有神龜，呼吸養流行爲兩分，通四支週遍。三一經云：腎有神龜，亦爲玄武，乃布流潤澤，通九竅，應九州也。"
                },
                {
                    "paragraph": "百脉孔竅盛以治。",
                    "zhushu": "三部中九竅，神龜戴水，上下九孔百脉皆和潤，所以治也。"
                },
                {
                    "paragraph": "上有星辰相合持，",
                    "zhushu": "五星藏内，皆内應外運。夫至人不矜其細行，朗然玄照，與天地合其德，與星辰合其度，一體離羅，萬象内應。迴元行事訣云：諸步七星之道，存眞人星從斗而來下，飛入兆口，注在肝中，使光照五藏，内外洞明。畢，北向再咽液九過矣。"
                },
                {
                    "paragraph": "下與恒山相連扶，",
                    "zhushu": "四維上下之中，北方最下，恒山北嶽，屬冀州分野是也。氣合玉泉，下丹田也。大洞經云：三光陰化成三官，藉三宫中九神，上中下三元君主命是也。"
                },
                {
                    "paragraph": "神長六寸衣玄黄，",
                    "zhushu": "神名嬰兒，字元陽子，一名谷玄，形長六寸，高一寸八分，赤衣，面外坐。"
                },
                {
                    "paragraph": "神妃十二同帷帳，",
                    "zhushu": "神妃則青腰玉女、玄光玉女，並隨母所帷帳，丹田中也，同守下元也。"
                },
                {
                    "paragraph": "五光玄曜照四方，",
                    "zhushu": "臍下都五藏，故云五光。周圓四方，故云四方是也。"
                },
                {
                    "paragraph": "青赤白黑服外黄。",
                    "zhushu": "腎在臍外，臍近腎上，是故名外黄。"
                },
                {
                    "paragraph": "周衛五重四門張，",
                    "zhushu": "上下相連，周衛五藏相通。五星相通，五重精液周流，五氣和釋。四門，臍四閉也。上通於頂，下徹包囊是也。"
                },
                {
                    "paragraph": "中虚靈臺華屋堂，",
                    "zhushu": "中虚，脾部。靈臺，心居。華盖之下，臍爲下海，總通六氣，府與心連也。"
                },
                {
                    "paragraph": "朱樓二寸自相通，",
                    "zhushu": "上清經云：臍有黄闕金室，銀城朱樓，是帝一君之内宅，三眞之寶宫是也。"
                },
                {
                    "paragraph": "神女游戲集中央。",
                    "zhushu": "二十四神行事訣云：神女名逐元馬，字道極生，男則陰莖内，女在子藏中。形長二寸二分，紫色，向外坐，能爲男女生雌雄。仙經云：人臍中有崑崙、弱水、玄冥之淵，日月所行，與外崑崙不異也。唯至人游神於内，則見矣。有一切神仙飛遊其上，故天有日月下臨地，萬物皆明，人亦如之。日月下照臍，臟腑常明，夜則日在胃，照於臍，故臍正當天地三元中央是也。"
                },
                {
                    "paragraph": "駕無極乘焉陰陽，",
                    "zhushu": "陰陽，下丹田神陰陽之主，舍二氣變化成形，故男女媾精萬化生，是眞神也。"
                },
                {
                    "paragraph": "御六蒼龍建左方，",
                    "zhushu": "左主陽，六蒼龍亦陽，三如六，生象之始，成形之質。仙經云：左三右七，戴九履一。故求眞之人，存三守一也。"
                },
                {
                    "paragraph": "白虎把弓居右方，",
                    "zhushu": "右陰白虎。弓，弧也，主陽。易曰：先張之弧，遇雨則吉。此言陰陽成象，斟酌變化也。"
                },
                {
                    "paragraph": "朱雀前引把五兵，",
                    "zhushu": "心爲朱雀，居脾上，故引前。五藏之中，各有神守，是五兵也。"
                },
                {
                    "paragraph": "玄武提鼓在後行，",
                    "zhushu": "玄武爲腎，當脊兩邊，故在後。下近胞囊，爲提鼓是也。"
                },
                {
                    "paragraph": "千神萬騎引縱横，",
                    "zhushu": "夫一體云内有三萬六千眞神，千二百精光，營衛成形，故至人若隳支體，黜聰明，養精靈，則千乘萬騎。西昇經云：神生形，形生神，形不得神，不能自生，神不得形，不能自成。言神人内省，能便致神仙是也。"
                },
                {
                    "paragraph": "軒如高舉登九蒼。",
                    "zhushu": "鶴鳴子和，修成則應貞，群仙翼軒，乃登九天也。"
                },
                {
                    "paragraph": "持我黄神轉八關，",
                    "zhushu": "黄神，黄庭也。八關，八方。若道行内修，備則周行六虚，必遊晏八方也。"
                },
                {
                    "paragraph": "與道合同相候迎，",
                    "zhushu": "提嚮必應，養神見報，與道合同，上昇紫極也。"
                },
                {
                    "paragraph": "還復返我形中央，",
                    "zhushu": "天道不遠，三五復返，可乎不可，然而不然，是形返神，歸乎妙寂是也。"
                },
                {
                    "paragraph": "恍惚出入面無常，",
                    "zhushu": "老子經云：恍惚中有物。眞誥曰：面爲尺宅。西昇經云：面常欲兩手摩拭，高下隨形，使之令極熱，令人面光澤，皺班不生，行之五年，色如少女。可謂山川行氣，常盈不設也。"
                },
                {
                    "paragraph": "莫能知之存與亡，",
                    "zhushu": "能知眞道，則不衰憊耳。"
                },
                {
                    "paragraph": "故曰五藏六府王。",
                    "zhushu": "五藏六府，各有司主之神。"
                },
                {
                    "paragraph": "法象會一於丹田，",
                    "zhushu": "名之爲一，盛德日生，道與一布化生三才。人得一成形，而生三部，存三守一與道同，子能知一萬事畢。一身精神是也。"
                },
                {
                    "paragraph": "誠能通之度世方，",
                    "zhushu": "誠，實也。方，道也。能守其身，必獲度世之道也。"
                },
                {
                    "paragraph": "臍下一寸名丹田，",
                    "zhushu": "下丹田名利機，一名精露，一名交陰，一名命門，三焦右府之命也。"
                },
                {
                    "paragraph": "諸腸之紆與脊連，",
                    "zhushu": "諸腸，大小腸也。愽著脊雙承胃口對臍，大腸左迴十六曲，小腸右迴十六曲，通津流迴入腸，爲滓穢之物，清者後胃過入腎胞，注陰陽爲溺，濁者從肺而分，入腸出乃爲糞，故通者絶飲食，而神靈爽是也。"
                },
                {
                    "paragraph": "方圓三寸名關元，",
                    "zhushu": "關元在臍三寸，一名關明，一名液門，男子藏精之閣，女子藏胎之。宫"
                },
                {
                    "paragraph": "縱横四方爲朱垣，",
                    "zhushu": "四方，四向也。縱横，交會於垣墻者也。"
                },
                {
                    "paragraph": "常在中央兩關門，",
                    "zhushu": "對兩腎中央也。"
                },
                {
                    "paragraph": "神長五寸衣金文，",
                    "zhushu": "旦暮存之，令人不衰，長二寸一分是也。"
                },
                {
                    "paragraph": "能大能小變化神。",
                    "zhushu": "神，妙萬而爲言。變化自然，運載一體是也。"
                },
                {
                    "paragraph": "下念天門依命門，",
                    "zhushu": "命門，臍也。一神名桃孩君，攝景氣之命始君也。是天地之元，陰陽之宗，金門玉闕，房户之寶。夫人命由桃君所制，魂化精液而生也。"
                },
                {
                    "paragraph": "去臍一尺變化神，",
                    "zhushu": "一尺，陰下胞上，在大便前，小便後，兩陰交會之門也。中有眞人，號曰制命。又人主年月之本，命攝壽夭之間，太一變魂，而並列司命之會，而合對魂帝君，故云司命之神，主典年壽魁柄長短之期，是以混合之府籍，莫不由之。一名靈華神宗也。"
                },
                {
                    "paragraph": "兩女夾侍敗亂人，",
                    "zhushu": "兩女，陰中之神，居命門下，和合陰陽皆由此。若眞神竭而精液不通，女則胎落，男則内神耗竭，而禍自連也。子欲不死，收精内視；子欲長生，收精返形。夫人誰不知生之可貴乎，只自不能正交接耳。旣泄之以尾閭，而氣濁液漏，腦减髓竭，徒益以消潰，故非本眞而邪其内與，元神漸喪而衰朽日逼也。西昇經云：人所以輕命早終者，自令返污之然，非天地毁、鬼神害，以其形故也。養生之夫，懇絶世事，凑彼山林，將欲斷諸浮俗，塞兌煉形，保正吉也。"
                },
                {
                    "paragraph": "能爲大小惑人心。",
                    "zhushu": "不見是而無悶，欲何所惑也，自然心清意定也。"
                },
                {
                    "paragraph": "意審三神病去身，",
                    "zhushu": "三丹田也。志誠必感也。"
                },
                {
                    "paragraph": "安樂道經可備矣。",
                    "zhushu": "一勞永逸，乃得長生，然後復何言乎！唯天道三一爲首門，乾坤是也。"
                },
                {
                    "paragraph": "合乾坤，定六府，",
                    "zhushu": "三生六府，寂然不動，感而不生，寂無爲也，遂使念之。"
                },
                {
                    "paragraph": "知機眞神，窮理盡性。",
                    "zhushu": "彼膚耳莫不遂内，修成辟災厄，長離膏肓，利貞無咎。讀如法，精義入神，深研妙賾，神精運化，引息相擁，形質已具還部矣。五藏生靈，三田内實，却衆邪魔若干犯，鬼賊逃亡去萬里，入水不濡，猛獸不據，秘五道、守我黄庭，蜜掘闕、鏡傳賢士，受者獲福，當朝太上也。"
                }
            ]
        }
    ]
}